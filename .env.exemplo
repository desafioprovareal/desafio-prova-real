# Configuração Geral — Desafio Prova Real (100% em Português)
# Copie este arquivo para .env e preencha apenas no ambiente de produção/VPS.

PORTA_SERVIDOR=8787
ORIGEM_PERMITIDA_CORS=https://desafioprovareal.pages.dev
SAL_CRIPTOGRAFICO_CENSO=TROQUE_POR_UMA_CHAVE_LONGA_ALEATORIA_DE_64_CARACTERES
INTERVALO_BOT_MINUTOS=15

# Proteção Anti-DDoS e Anti-Robôs (Cloudflare Gratuita)
CLOUDFLARE_TUNNEL_TOKEN=COLE_AQUI_O_TOKEN_DO_TUNEL_ZERO_TRUST
TURNSTILE_CHAVE_SECRETA=

# Login Social do Ranking (Opcional na Onda 0)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
